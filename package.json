{
  "name": "@d0paminedriven/pdfdown",
  "version": "0.1.0",
  "description": "Rust powered PDF extraction for Node",
  "keywords": [
    "N-API",
    "NAPI",
    "Rust",
    "napi-rs",
    "node-addon",
    "node-addon-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DopamineDriven/pdfdown"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "browser.js"
  ],
  "main": "index.js",
  "browser": "browser.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "artifacts:ocr": "napi artifacts --package-json-path ocr/package.json --npm-dir ocr/npm",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "napi build --platform --release --no-const-enum --features render",
    "build:debug": "napi build --platform --no-const-enum --features render",
    "build:ocr": "napi build --platform --release --no-const-enum --features ocr,render --package-json-path ocr/package.json --output-dir ocr",
    "create-npm-dirs:ocr": "napi create-npm-dirs --package-json-path ocr/package.json --npm-dir ocr/npm",
    "format": "run-p format:prettier format:rs format:toml",
    "format:prettier": "prettier . -w",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "oxlint .",
    "lint:rs": "cargo fmt -- --check && cargo clippy --all-features -- -D warnings",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "test:ocr": "ava --config ocr/ava.config.mjs",
    "preversion": "napi build --platform --no-const-enum && git add .",
    "version": "napi version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.5",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "@napi-rs/cli": "^3.10.9",
    "@napi-rs/wasm-runtime": "^1.2.6",
    "@oxc-node/core": "^1.0.1",
    "@oxc-node/core-wasm32-wasi": "^1.0.1",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.4",
    "@types/node": "^26.6.6",
    "ava": "^8.2.0",
    "chalk": "^6.0.1",
    "emnapi": "2.0.0-alpha.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tinybench": "^6.2.2",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "@napi-rs/wasm-runtime": "1.2.5"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json|toml)": [
      "oxfmt --write"
    ]
  },
  "napi": {
    "binaryName": "pdfdown",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "i686-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf",
      "aarch64-apple-darwin",
      "aarch64-linux-android",
      "x86_64-unknown-freebsd",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "armv7-linux-androideabi",
      "wasm32-wasip1-threads"
    ]
  },
  "prettier": {
    "arrowParens": "always",
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "ava": {
    "environmentVariables": {
      "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json"
    },
    "extensions": [
      "ts"
    ],
    "files": [
      "__test__/**/*.spec.ts"
    ],
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ],
    "timeout": "2m",
    "workerThreads": false
  },
  "engines": {
    "node": ">= 22.14.0 < 23 || >= 23.6.0"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
