# Auto detect text files and perform LF normalization
*        text=auto


*.ts    text eol=lf
*.tsx   text eol=lf
*.rs    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.debug text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.mts   text eol=lf
*.cts   text eol=lf
*.xml   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Fixtures compared byte for byte, and native artifacts
*.pdf   binary
*.xlsx  binary
*.node  binary
*.wasm  binary

# Generated codes
index.js                         linguist-detectable=false
index.d.ts                       linguist-detectable=false
pdfdown.wasi-browser.js linguist-detectable=false
pdfdown.wasi.cjs        linguist-detectable=false
wasi-worker-browser.mjs          linguist-detectable=false
wasi-worker.mjs                  linguist-detectable=false
