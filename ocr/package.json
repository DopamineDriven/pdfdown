{
  "name": "@d0paminedriven/pdfdown-ocr",
  "version": "0.11.0",
  "description": "Rust powered PDF extraction for Node with OCR fallback (requires system tesseract).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DopamineDriven/pdfdown"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "pdfdown_ocr.napi.js",
    "README.md"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "main": "index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "napi": {
    "binaryName": "pdfdown_ocr",
    "dtsHeaderFile": "types/dts-header.ts",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">= 26"
  }
}
